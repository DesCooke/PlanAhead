<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HomeBudget.Views.DashboardPage"
    Title="Dashboard">

    <VerticalStackLayout
        Padding="30"
        Spacing="20">

        <Label
            Text="{Binding Title}"
            FontSize="32"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding WelcomeMessage}"
            FontSize="20"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding Version}"
            HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>