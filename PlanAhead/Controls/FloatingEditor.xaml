<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.FloatingEditor"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Self">

    <Grid>

        <!--  Main input border  -->
        <Border
            x:Name="InputBorder"
            Padding="12,12"
            BackgroundColor="{AppThemeBinding Light=White,
                                              Dark=#202020}"
            Stroke="{AppThemeBinding Light=#D0D0D0,
                                     Dark=#505050}"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">

            <Editor
                x:Name="EditorControl"
                AutoSize="TextChanges"
                BackgroundColor="Transparent"
                Focused="Editor_Focused"
                FontSize="15"
                MaximumHeightRequest="{Binding Source={x:Reference Self}, Path=MaximumHeight}"
                MinimumHeightRequest="{Binding Source={x:Reference Self}, Path=MinimumHeight}"
                Text="{Binding Source={x:Reference Self}, Path=Text, Mode=TwoWay}"
                TextColor="{DynamicResource PrimaryTextColor}"
                Unfocused="Editor_Unfocused"
                VerticalOptions="Fill" />

        </Border>


        <!--  Hint shown inside empty editor  -->
        <Label
            x:Name="HintLabel"
            Margin="16,12"
            FontSize="15"
            HorizontalOptions="Start"
            InputTransparent="True"
            Text="{Binding Source={x:Reference Self}, Path=Label}"
            TextColor="{DynamicResource Gray200}"
            VerticalOptions="Start" />


        <!--  Floating label  -->
        <Border
            x:Name="FloatingLabelBorder"
            Margin="10,0,0,0"
            Padding="4,0"
            BackgroundColor="{AppThemeBinding Light=White,
                                              Dark=#202020}"
            HorizontalOptions="Start"
            InputTransparent="True"
            Opacity="0"
            TranslationY="0"
            VerticalOptions="Start">

            <Label
                x:Name="FloatingLabel"
                FontSize="12"
                Text="{Binding Source={x:Reference Self}, Path=Label}"
                TextColor="{DynamicResource Gray200}" />

        </Border>

    </Grid>

</ContentView>