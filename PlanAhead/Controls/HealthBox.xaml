<ContentView
    x:Class="PlanAhead.Controls.HealthBox"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border
        Margin="0,0,0,20"
        Padding="20"
        HorizontalOptions="Start"
        Stroke="{AppThemeBinding Light=#D0D0D0,
                                 Dark=#505050}"
        StrokeShape="RoundRectangle 12"
        StrokeThickness="1">

        <VerticalStackLayout Spacing="10">

            <HorizontalStackLayout Spacing="6">

                <BoxView
                    CornerRadius="5"
                    HeightRequest="10"
                    WidthRequest="10"
                    Color="{Binding Source={x:Reference Root}, Path=HealthColour}" />

                <Label FontAttributes="Bold" Text="{Binding Source={x:Reference Root}, Path=HealthText}" />

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </Border>

</ContentView>