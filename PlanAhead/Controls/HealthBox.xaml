<ContentView
    x:Class="PlanAhead.Controls.HealthBox"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border
        Padding="10,4"
        BackgroundColor="{Binding Source={x:Reference Root}, Path=HealthBackground}"
        StrokeShape="RoundRectangle 16"
        StrokeThickness="0">

        <HorizontalStackLayout Spacing="6">

            <BoxView
                WidthRequest="10"
                HeightRequest="10"
                CornerRadius="5"
                Color="{Binding Source={x:Reference Root}, Path=HealthColour}" />

            <Label
                FontAttributes="Bold"
                Text="{Binding Source={x:Reference Root}, Path=HealthText}" />

        </HorizontalStackLayout>

    </Border>

</ContentView>