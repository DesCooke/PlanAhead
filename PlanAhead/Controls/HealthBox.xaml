<ContentView
    x:Class="PlanAhead.Controls.HealthBox"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Grid>

        <VerticalStackLayout Spacing="10">

            <HorizontalStackLayout Spacing="6">

                <BoxView
                    BackgroundColor="Transparent"
                    CornerRadius="5"
                    HeightRequest="10"
                    WidthRequest="10"
                    Color="{Binding Source={x:Reference Root}, Path=HealthColour}" />

                <Label FontAttributes="Bold" Text="{Binding Source={x:Reference Root}, Path=HealthText}" />

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </Grid>

</ContentView>