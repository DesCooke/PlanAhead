<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.CheckboxBox"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Self">

    <HorizontalStackLayout Spacing="4">

        <Label
            Grid.Column="0"
            FontAttributes="Bold"
            Text="{Binding Source={x:Reference Self}, Path=TextLabel}"
            VerticalOptions="Center" />

        <CheckBox
            Grid.Column="1"
            Margin="0,-4,0,0"
            IsChecked="{Binding Source={x:Reference Self}, Path=Checkbox}"
            VerticalOptions="Center" />

    </HorizontalStackLayout>

</ContentView>