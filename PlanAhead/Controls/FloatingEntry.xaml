<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.FloatingEntry"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Self">

    <Grid>


        <!--  Main input border  -->
        <Border
            x:Name="InputBorder"
            Padding="12,6"
            BackgroundColor="{AppThemeBinding Light=White,
                                              Dark=#202020}"
            Stroke="{AppThemeBinding Light=#D0D0D0,
                                     Dark=#505050}"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">

                <Entry
                    x:Name="EntryControl"
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    Focused="Entry_Focused"
                    FontSize="15"
                    IsPassword="{Binding Source={x:Reference Self}, Path=IsPassword}"
                    Keyboard="{Binding Source={x:Reference Self}, Path=Keyboard}"
                    Text="{Binding Source={x:Reference Self}, Path=Text, Mode=TwoWay}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    Unfocused="Entry_Unfocused"
                    VerticalOptions="Center" />

                <ImageButton
                    x:Name="EyeButton"
                    Grid.Column="1"
                    Margin="0"
                    Padding="8"
                    BackgroundColor="Transparent"
                    Clicked="EyeButton_Clicked"
                    HeightRequest="10"
                    IsVisible="{Binding Source={x:Reference Self}, Path=IsPassword}"
                    Source="eye_closed.png"
                    WidthRequest="10" />

            </Grid>

        </Border>


        <!--  Hint shown inside empty field  -->
        <Label
            x:Name="HintLabel"
            Margin="16,0"
            FontSize="15"
            HorizontalOptions="Start"
            InputTransparent="True"
            Text="{Binding Source={x:Reference Self}, Path=Label}"
            TextColor="{DynamicResource Gray200}"
            VerticalOptions="Center" />


        <!--  Floating label  -->
        <Border
            x:Name="FloatingLabelBorder"
            Margin="10,0,0,0"
            Padding="4,0"
            BackgroundColor="{AppThemeBinding Light=White,
                                              Dark=#202020}"
            HorizontalOptions="Start"
            InputTransparent="True"
            Opacity="0"
            TranslationY="0"
            VerticalOptions="Start">

            <Label
                x:Name="FloatingLabel"
                FontSize="12"
                Text="{Binding Source={x:Reference Self}, Path=Label}"
                TextColor="{DynamicResource Gray200}" />

        </Border>

    </Grid>

</ContentView>