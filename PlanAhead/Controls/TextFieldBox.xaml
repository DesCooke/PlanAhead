<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.TextFieldBox"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Self">

    <HorizontalStackLayout Padding="20" Spacing="16">

        <Label FontAttributes="Bold" Text="{Binding Source={x:Reference Self}, Path=TextLabel}" />

        <Label Text="{Binding Source={x:Reference Self}, Path=TextContent}" />

    </HorizontalStackLayout>




</ContentView>