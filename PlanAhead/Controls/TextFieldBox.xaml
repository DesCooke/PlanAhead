<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.TextFieldBox"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Self">

    <Border
        Margin="0,0,0,0"
        Padding="{Binding Source={x:Reference Self}, Path=ButtonPadding}"
        HorizontalOptions="Fill"
        Stroke="{AppThemeBinding Light=#D0D0D0,
                                 Dark=#505050}"
        StrokeShape="RoundRectangle 12"
        StrokeThickness="1">

        <VerticalStackLayout HorizontalOptions="Fill" Spacing="10">

            <Label FontAttributes="Bold" Text="{Binding Source={x:Reference Self}, Path=TextLabel}" />

            <Label Text="{Binding Source={x:Reference Self}, Path=TextContent}" />

        </VerticalStackLayout>

    </Border>




</ContentView>