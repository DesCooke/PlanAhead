<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.LargeOptionButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PlanAhead.Controls"
    x:Name="Root">

    <Grid>

        <!--  List item  -->
        <Border
            Padding="20"
            Stroke="{AppThemeBinding Light=#D0D0D0,
                                     Dark=#505050}"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">

                <Grid.GestureRecognizers>

                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=OpenCommand}" />

                </Grid.GestureRecognizers>

                <!--  Icon  -->
                <controls:ObjectIcon
                    Grid.Column="0"
                    ButtonPadding="{StaticResource ListPadding}"
                    ButtonSize="{StaticResource ListButtonSize}"
                    IconId="{Binding Source={x:Reference Root}, Path=IconId}"
                    IconSize="{StaticResource ListIconSize}"
                    IsVisible="{Binding Source={x:Reference Root}, Path=HasIcon}"
                    Status="{Binding Source={x:Reference Root}, Path=Status}"
                    VerticalOptions="Center" />

                <!--  Text  -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="3"
                    VerticalOptions="Center">

                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        LineBreakMode="WordWrap"
                        Text="{Binding Source={x:Reference Root}, Path=Title}" />

                    <Label
                        FontSize="13"
                        LineBreakMode="WordWrap"
                        Text="{Binding Source={x:Reference Root}, Path=Subtitle}" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        LineBreakMode="WordWrap"
                        Text="{Binding Source={x:Reference Root}, Path=Detail}" />

                </VerticalStackLayout>
            </Grid>

        </Border>

    </Grid>

</ContentView>