<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.ObjectIcon"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Self"
    HeightRequest="{Binding Source={x:Reference Self}, Path=ButtonSize}"
    WidthRequest="{Binding Source={x:Reference Self}, Path=ButtonSize}">

    <Border Style="{StaticResource CardBorderStyle}">

        <VerticalStackLayout VerticalOptions = "Center" HorizontalOptions="Center" Spacing="10">

            <Image
                x:Name="IconImage"
                Aspect="AspectFit"
                HeightRequest="{Binding Source={x:Reference Self}, Path=IconSize}"
                WidthRequest="{Binding Source={x:Reference Self}, Path=IconSize}" />

        </VerticalStackLayout>

    </Border>




</ContentView>