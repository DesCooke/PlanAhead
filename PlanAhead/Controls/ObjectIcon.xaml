<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.ObjectIcon"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Self"
    HeightRequest="{Binding Source={x:Reference Self}, Path=ButtonSize}"
    WidthRequest="{Binding Source={x:Reference Self}, Path=ButtonSize}">

    <Border Padding="0" Style="{StaticResource CardBorderStyle}">

        <Image
            x:Name="IconImage"
            Aspect="AspectFit"
            HeightRequest="{Binding Source={x:Reference Self}, Path=IconSize}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="{Binding Source={x:Reference Self}, Path=IconSize}" />

    </Border>
</ContentView>