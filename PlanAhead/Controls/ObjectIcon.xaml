<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.ObjectIcon"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Self"
    HeightRequest="{Binding Source={x:Reference Self}, Path=ButtonSize}"
    WidthRequest="{Binding Source={x:Reference Self}, Path=ButtonSize}">

    <Border
        Margin="0,0,0,0"
        Padding="{Binding Source={x:Reference Self}, Path=ButtonPadding}"
        HorizontalOptions="Start"
        Stroke="{AppThemeBinding Light=#D0D0D0,
                                 Dark=#505050}"
        StrokeShape="RoundRectangle 12"
        StrokeThickness="1">

        <VerticalStackLayout HorizontalOptions="Start" Spacing="10">

            <Image
                x:Name="IconImage"
                Aspect="AspectFit"
                HeightRequest="{Binding Source={x:Reference Self}, Path=IconSize}"
                WidthRequest="{Binding Source={x:Reference Self}, Path=IconSize}" />

        </VerticalStackLayout>

    </Border>




</ContentView>