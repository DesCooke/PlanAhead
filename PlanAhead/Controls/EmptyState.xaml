<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Self">

    <VerticalStackLayout
        HorizontalOptions="Center"
        Spacing="12"
        VerticalOptions="Center">

        <Label
            FontSize="64"
            HorizontalOptions="Center"
            Text="{Binding Source={x:Reference Self}, Path=Icon}" />

        <Label
            FontAttributes="Bold"
            FontSize="22"
            HorizontalOptions="Center"
            Text="{Binding Source={x:Reference Self}, Path=Title}" />

        <Label
            FontSize="15"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Opacity="0.7"
            Text="{Binding Source={x:Reference Self}, Path=Message}"
            WidthRequest="250" />

    </VerticalStackLayout>

</ContentView>