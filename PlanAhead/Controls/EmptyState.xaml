<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.EmptyState"
    x:Name="Self"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Spacing="12">

        <Label
            FontSize="64"
            HorizontalOptions="Center"
            Text="{Binding Source={x:Reference Self}, Path=Icon}" />

        <Label
            FontSize="22"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            Text="{Binding Source={x:Reference Self}, Path=Title}" />

        <Label
            FontSize="15"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Opacity="0.7"
            WidthRequest="250"
            Text="{Binding Source={x:Reference Self}, Path=Message}" />

    </VerticalStackLayout>

</ContentView>