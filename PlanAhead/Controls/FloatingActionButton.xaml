<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.FloatingActionButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border
        BackgroundColor="{AppThemeBinding Light=#1976D2,
                                          Dark=#2196F3}"
        HeightRequest="64"
        HorizontalOptions="End"
        StrokeShape="RoundRectangle 32"
        StrokeThickness="0"
        VerticalOptions="End"
        WidthRequest="64">

        <Button
            BackgroundColor="Transparent"
            BorderWidth="0"
            Command="{Binding Command, Source={x:Reference Root}}"
            CornerRadius="32"
            FontAttributes="Bold"
            FontSize="28"
            Text="{Binding Text, Source={x:Reference Root}}"
            TextColor="White" />

    </Border>

</ContentView>