<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="PlanAhead.Controls.FloatingActionButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border
        WidthRequest="56"
        HeightRequest="56"
        HorizontalOptions="End"
        VerticalOptions="End"
        BackgroundColor="{AppThemeBinding Light=#1976D2, Dark=#2196F3}"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 28">

        <ImageButton
            BackgroundColor="Transparent"
            CornerRadius="28"
            Command="{Binding Source={x:Reference Root}, Path=Command}"
            HeightRequest="56"
            HorizontalOptions="Fill"
            Padding="16"
            Source="{Binding Source={x:Reference Root}, Path=Icon}"
            VerticalOptions="Fill"
            WidthRequest="56" />

    </Border>

</ContentView>