<?xml version="1.0" encoding="utf-8" ?>

<Shell
    x:Class="PlanAhead.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:accounts="clr-namespace:PlanAhead.Views.Accounts"
    xmlns:funds="clr-namespace:PlanAhead.Views.Funds"
    xmlns:views="clr-namespace:PlanAhead.Views">

    <FlyoutItem Title="Dashboard">
        <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Developer">
        <ShellContent Title="Developer Tools" ContentTemplate="{DataTemplate views:DeveloperToolsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Accounts">

        <ShellContent Title="Accounts" ContentTemplate="{DataTemplate accounts:AccountsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Funds">
        <ShellContent Title="Funds" ContentTemplate="{DataTemplate funds:FundsPage}" />
    </FlyoutItem>

</Shell>