<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PlanAhead.Views.Popups.IconPickerPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="IconPickerPopup">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Icons}" SelectionMode="Single">

            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="5" />
            </CollectionView.ItemsLayout>

        </CollectionView>
    </VerticalStackLayout>
</ContentPage>