<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PlanAhead.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            Command="{Binding LogoutCommand}"
            IconImageSource="logout.png"
            Order="Primary"
            Priority="0"
            Text="Logout" />

    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="30" Spacing="20">

        <Label
            FontAttributes="Bold"
            FontSize="32"
            HorizontalOptions="Center"
            Text="{Binding Title}" />

        <Label
            FontSize="20"
            HorizontalOptions="Center"
            Text="{Binding WelcomeMessage}" />

        <Label HorizontalOptions="Center" Text="{Binding Version}" />

        <Label HorizontalOptions="Center" Text="{Binding SyncMethod}" />

        <Label HorizontalOptions="Center" Text="{Binding CurrentSupabaseUser}" />

    </VerticalStackLayout>

</ContentPage>