<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PlanAhead.Views.Funds.FundsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PlanAhead.Controls"
    Title="{Binding Title}">

    <Grid>

        <CollectionView
            IsVisible="{Binding HasFunds}"
            ItemsSource="{Binding Funds}"
            SelectedItem="{Binding SelectedFund}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <SwipeView>

                        <SwipeView.RightItems>

                            <SwipeItems Mode="Reveal">

                                <SwipeItem
                                    BackgroundColor="Red"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                    CommandParameter="{Binding}"
                                    Text="Delete" />

                            </SwipeItems>

                        </SwipeView.RightItems>

                        <Border Style="{StaticResource CardBorderStyle}">

                            <Grid
                                ColumnDefinitions="auto,*,auto"
                                ColumnSpacing="12"
                                RowDefinitions="Auto,Auto,Auto"
                                RowSpacing="4">

                                <controls:ObjectIcon
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="0"
                                    IconId="{Binding IconId}"
                                    IconSize="{StaticResource ListIconSize}" />

                                <!--  Fund Name  -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Name}" />

                                <!--  Frequency  -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="13"
                                    Opacity="0.6"
                                    Text="{Binding Frequency}" />

                                <!--  Description  -->
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    FontSize="13"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Text="{Binding Description}" />

                                <!--  Actions  -->
                                <controls:CardActionsButton
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="2"
                                    CommandParameter="{Binding}"
                                    DeleteCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                    EditCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center" />

                            </Grid>

                        </Border>
                    </SwipeView>


                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <controls:EmptyState
            Title="No Funds"
            Icon="💰"
            IsVisible="{Binding HasNoFunds}"
            Message="Tap the + button to create your first fund." />

        <controls:FloatingActionButton
            Margin="24"
            Command="{Binding AddCommand}"
            HorizontalOptions="End"
            VerticalOptions="End" />

    </Grid>

</ContentPage>