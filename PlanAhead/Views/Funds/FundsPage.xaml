<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PlanAhead.Views.Funds.FundsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PlanAhead.Controls"
    Title="{Binding Title}">

    <Grid Margin="16,16,16,16">

        <CollectionView
            IsVisible="{Binding HasFunds}"
            ItemsSource="{Binding Funds}"
            SelectedItem="{Binding SelectedFund}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <controls:SwipeListItem
                        IconId="{Binding IconId}"

                        Title="{Binding Name}"
                        Subtitle="{Binding Description}"
                        Detail="{Binding Frequency}"
                        Status="{Binding Status}"
                        
                        DeleteCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                        DeleteCommandParameter="{Binding}"
                        EditCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                        EditCommandParameter="{Binding}"
                        OpenCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                        OpenCommandParameter="{Binding}" />

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <controls:EmptyState
            Title="No Funds"
            Icon="💰"
            IsVisible="{Binding HasNoFunds}"
            Message="Tap the + button to create your first fund." />

        <controls:FloatingActionButton
            Margin="24"
            Command="{Binding AddCommand}"
            HorizontalOptions="End"
            VerticalOptions="End" />

    </Grid>

</ContentPage>