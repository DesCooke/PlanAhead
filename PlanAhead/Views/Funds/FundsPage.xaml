<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PlanAhead.Views.Funds.FundsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PlanAhead.Controls"
    Title="{Binding Title}">

    <Grid>

        <!-- Placeholder until we add the CollectionView -->
        <CollectionView
            ItemsSource="{Binding Funds}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedFund}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="10,5"
                        Padding="12">

                        <VerticalStackLayout>

                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{Binding Name}" />

                            <Label
                                Opacity="0.7"
                                Text="{Binding Frequency}" />
                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>
        
        <controls:FloatingActionButton
            Margin="24"
            HorizontalOptions="End"
            VerticalOptions="End"
            Command="{Binding AddCommand}" />

    </Grid>

</ContentPage>