<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PlanAhead.Views.Startup.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PlanAhead.Controls"
    Title="Sign In">

    <ScrollView>

        <VerticalStackLayout Padding="30" Spacing="24">

            <Label
                FontAttributes="Bold"
                FontSize="32"
                HorizontalOptions="Center"
                Text="PlanAhead" />

            <Label
                HorizontalTextAlignment="Center"
                Opacity="0.7"
                Text="Sign in to synchronise your data across devices." />

            <controls:FloatingEntry
                Keyboard="Email"
                Label="Email"
                Placeholder="name@example.com"
                Text="{Binding Email}" />

            <controls:FloatingEntry
                IsPassword="True"
                Label="Password"
                Placeholder="Password"
                Text="{Binding Password}" />

            <Button Command="{Binding LoginCommand}" Text="Sign In" />

            <Button Command="{Binding RegisterCommand}" Text="Create Account" />

            <BoxView HeightRequest="1" />

            <Button
                Command="{Binding OfflineOnlyCommand}"
                IsEnabled="True"
                Text="Just Start in Offline Only Mode" />

            <Button
                Command="{Binding GoogleCommand}"
                IsEnabled="False"
                Text="Continue with Google" />

            <Button
                BackgroundColor="Transparent"
                Command="{Binding CancelCommand}"
                Text="Back"
                TextColor="{AppThemeBinding Light=Black,
                                            Dark=White}" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>