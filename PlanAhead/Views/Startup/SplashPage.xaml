<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PlanAhead.Views.Startup.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="SplashPage"
    NavigationPage.HasNavigationBar="False">
    <VerticalStackLayout
        HorizontalOptions="Center"
        Spacing="20"
        VerticalOptions="Center">

        <Grid>

            <Image Aspect="AspectFill" Source="planahead_background.png" />

            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="20"
                VerticalOptions="Center">

                <Image Source="planahead_icon.png" WidthRequest="180" />

                <Label
                    FontAttributes="Bold"
                    FontSize="40"
                    Text="PlanAhead" />

                <ActivityIndicator IsRunning="True" />

            </VerticalStackLayout>

        </Grid>

        <ActivityIndicator
            HeightRequest="40"
            IsRunning="True"
            WidthRequest="40" />

        <Label HorizontalOptions="Center" Text="Starting PlanAhead..." />
    </VerticalStackLayout>
</ContentPage>