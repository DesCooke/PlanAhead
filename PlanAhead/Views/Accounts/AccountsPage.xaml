<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PlanAhead.Views.Accounts.AccountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PlanAhead.Controls"
    Title="{Binding Title}">

    <Grid>

        <CollectionView
            IsVisible="{Binding HasAccounts}"
            ItemsSource="{Binding Accounts}"
            SelectedItem="{Binding SelectedAccount}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <SwipeView>

                        <SwipeView.LeftItems>

                            <SwipeItems Mode="Reveal">

                                <SwipeItem
                                    BackgroundColor="LightSkyBlue"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                    CommandParameter="{Binding}"
                                    Text="Edit" />

                            </SwipeItems>

                        </SwipeView.LeftItems>

                        <SwipeView.RightItems>

                            <SwipeItems Mode="Reveal">

                                <SwipeItem
                                    BackgroundColor="#F44336"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                    CommandParameter="{Binding}"
                                    Text="Delete" />

                            </SwipeItems>

                        </SwipeView.RightItems>

                        <controls:Card Padding="20">

                            <HorizontalStackLayout Padding="4" Spacing="16">

                                <!--  Tappable Account Area  -->
                                <HorizontalStackLayout HorizontalOptions="FillAndExpand" Spacing="16">

                                    <HorizontalStackLayout.GestureRecognizers>

                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommand}" CommandParameter="{Binding}" />

                                    </HorizontalStackLayout.GestureRecognizers>

                                    <controls:ObjectIcon
                                        IconId="{Binding IconId}"
                                        IconSize="40"
                                        VerticalOptions="Center" />

                                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="20"
                                            Text="{Binding Name}" />

                                        <Label
                                            FontSize="13"
                                            Opacity="0.65"
                                            Text="{Binding Description}" />

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            Text="{Binding OpeningBalanceDisplay}" />

                                    </VerticalStackLayout>

                                </HorizontalStackLayout>

                            </HorizontalStackLayout>

                        </controls:Card>

                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <controls:EmptyState
            Title="No Accounts"
            Icon="💰"
            IsVisible="{Binding HasNoAccounts}"
            Message="Tap the + button to create your first account." />

        <controls:FloatingActionButton
            Margin="24"
            Command="{Binding AddCommand}"
            HorizontalOptions="End"
            Icon="add.png"
            VerticalOptions="End" />

    </Grid>

</ContentPage>