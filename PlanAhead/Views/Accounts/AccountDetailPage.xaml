<ContentPage
    x:Class="PlanAhead.Views.Accounts.AccountDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Account">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Account Name" />

            <Entry Text="{Binding AccountName}" />

            <Label Text="Opening Balance" />

            <Entry Keyboard="Numeric" Text="{Binding Balance}" />

            <CheckBox IsChecked="{Binding IncludeInTotal}" />

            <Label Text="Include in Total" />

            <HorizontalStackLayout>

                <Button Command="{Binding SaveCommand}" Text="Save" />

                <Button Command="{Binding CancelCommand}" Text="Cancel" />

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>