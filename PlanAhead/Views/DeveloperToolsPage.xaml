<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PlanAhead.Views.DeveloperToolsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Developer Tools">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                FontAttributes="Bold"
                FontSize="30"
                Text="Developer Tools" />

            <Label Text="Database" />

            <Button Command="{Binding ShowDatabasePathCommand}" Text="Show Database Path" />

            <Button Command="{Binding ShowAccountCountCommand}" Text="Show Account Count" />

            <Button Command="{Binding DeleteAllCommand}" Text="Clear All - Start as New Install" />

            <Button Command="{Binding ShowAllAccountsCommand}" Text="Show All Accounts" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>